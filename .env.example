# MemePulse Environment Configuration

# OpenAI Configuration
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Farcaster/Neynar Configuration
VITE_NEYNAR_API_KEY=your_neynar_api_key_here

# Airstack Configuration
VITE_AIRSTACK_API_KEY=your_airstack_api_key_here

# App Configuration
VITE_APP_NAME=MemePulse
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Analytics Configuration (Optional)
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here
VITE_MIXPANEL_TOKEN=your_mixpanel_token_here

# Feature Flags
VITE_ENABLE_FARCASTER_TRENDS=true
VITE_ENABLE_ONCHAIN_TRENDS=true
VITE_ENABLE_REAL_TIME_ANALYTICS=true
VITE_ENABLE_SUBSCRIPTION_FEATURES=true

# Development Configuration
VITE_DEBUG_MODE=false
VITE_MOCK_API_RESPONSES=false
